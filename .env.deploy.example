# Copy to .env.deploy.local and fill in your deployment settings.
# API_BASE_URL is public in compiled apps. Never put passwords in a URL.
API_BASE_URL=https://your-api.example
RAILWAY_PROJECT_ID=
RAILWAY_SERVICE_ID=
RAILWAY_ENVIRONMENT=production
APPLE_TEAM_ID=
TV_HOST=
TIZEN_SIGNING_PROFILE=
# Optional; otherwise ~/tizen-studio is used.
# TIZEN_SDK_PATH=/path/to/tizen-studio
