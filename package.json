{
  "name": "bos42",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=server --watch-path=shared server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:live": "node scripts/check-live.mjs",
    "typecheck": "tsc -b",
    "build:native": "node scripts/build-native.mjs",
    "ios:add": "npx cap add ios",
    "ios:sync": "npm run configure:ios && npm run build:native && npx cap sync ios",
    "ios:open": "npm run configure:ios && npx cap open ios",
    "stage:railway": "node scripts/stage-railway.mjs",
    "build:tizen": "node scripts/build-tizen.mjs",
    "deploy:tizen": "python3 scripts/deploy-tizen.py",
    "check:railway": "npm run stage:railway && node scripts/check-railway-stage.mjs",
    "check": "npm test && npm run build && npm run build:native && npm run build:tizen && npm run check:railway",
    "configure:ios": "node scripts/configure-ios.mjs",
    "deploy:railway": "node scripts/deploy-railway.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "egm96-universal": "^1.1.1",
    "express": "^5.1.0",
    "maplibre-gl": "^6.11.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
